# Copy to .env and fill in. Never commit .env.

# https://twelvedata.com/ (free tier is enough: 2 calls per hour)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# From @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: account balance in USD. When set, entry alerts include a lot size
# for risk_pct_per_signal (config.json). 1 lot = 100 oz.
ACCOUNT_BALANCE=

# Optional: Postgres on Render. Without it the bot uses a local SQLite file.
DATABASE_URL=

PORT=5000
